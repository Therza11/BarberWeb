# Prisma supports the native connection string format for PostgreSQL.
# See: https://pris.ly/d/connection-strings

# Local dev via `npx prisma dev` prints a URL like this one:
DATABASE_URL="postgres://postgres:postgres@localhost:51214/barberweb?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/barberweb_shadow?sslmode=disable"

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="reemplazar-con-un-valor-aleatorio"

APP_URL="http://localhost:3000"

# Email que ven los negocios en plan Gratis para pedir upgrade a Pro (manual, sin pasarela de pago todavia)
CONTACTO_UPGRADE_EMAIL="contacto@barberweb.app"
CRON_SECRET="reemplazar-con-un-valor-aleatorio"

# Si se dejan vacios, las notificaciones se simulan (log en consola)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Bot de reservas por WhatsApp (v2.4) - una sola cuenta de WhatsApp Business
# para toda la plataforma (ver src/lib/whatsapp-bot.ts). Configurar en el
# dashboard de Meta > WhatsApp > Configuration > Webhooks, apuntando a
# https://tu-dominio/api/webhooks/whatsapp con este mismo WHATSAPP_VERIFY_TOKEN.
# WHATSAPP_DISPLAY_NUMBER es el numero que se usa en el link wa.me del boton
# "Reservar por WhatsApp" (solo digitos, con codigo de pais, sin +).
WHATSAPP_VERIFY_TOKEN="reemplazar-con-un-valor-aleatorio"
WHATSAPP_DISPLAY_NUMBER=""

# Wompi (Colombia) - sena/deposito del plan Pro. Una sola cuenta para toda la
# plataforma (no una por negocio). Si se dejan vacias, el pago de la sena se
# simula como aprobado (igual que WhatsApp/Resend sin credenciales).
# Claves publica/de integridad: dashboard de Wompi > Desarrolladores.
# WOMPI_EVENTS_SECRET: dashboard de Wompi > Eventos (para verificar el webhook).
WOMPI_PUBLIC_KEY=""
WOMPI_INTEGRITY_SECRET=""
WOMPI_EVENTS_SECRET=""
WOMPI_ENV="sandbox"
