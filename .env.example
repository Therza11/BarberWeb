# Prisma supports the native connection string format for PostgreSQL.
# See: https://pris.ly/d/connection-strings

# Local dev via `npx prisma dev` prints a URL like this one:
DATABASE_URL="postgres://postgres:postgres@localhost:51214/barberweb?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/barberweb_shadow?sslmode=disable"

# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="reemplazar-con-un-valor-aleatorio"

APP_URL="http://localhost:3000"

# Email que ven los negocios en plan Gratis para pedir upgrade a Pro (manual, sin pasarela de pago todavia)
CONTACTO_UPGRADE_EMAIL="contacto@barberweb.app"
CRON_SECRET="reemplazar-con-un-valor-aleatorio"

# Si se dejan vacios, las notificaciones se simulan (log en consola)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
